POSTGRES_USER=agua
POSTGRES_PASSWORD=agua_secret
POSTGRES_DB=agua_alerta
DATABASE_URL=postgresql+psycopg://agua:agua_secret@localhost:5432/agua_alerta
JWT_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_COOKIE_NAME=agua_refresh
JWT_COOKIE_SECURE=false
PHOTOS_PATH=./data/photos
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3080,http://localhost:8081
# Opcional: vacío desactiva regex LAN en config por defecto del código
# CORS_ORIGIN_REGEX=
GROUPING_DISTANCE_M=75
DUPLICATE_SUGGEST_RADIUS_M=50
PRIORITY_POP_REF=5000
LOG_LEVEL=INFO
PASSWORD_RESET_DEV_EXPOSE_TOKEN=true
# Build de la imagen web (nginx). No usar localhost aquí.
DOCKER_WEB_API_BASE_URL=/api/v1
# Tiles del mapa. Vite las incrusta al construir `web` (no cambian en caliente).
# Vacías o ausentes → Esri World Light Gray (el default de esta rama, sin clave).
# VITE_MAP_TILE_URL tiene prioridad sobre el alias VITE_TILE_URL.
# Esri usa {z}/{y}/{x}. OpenStreetMap usa {z}/{x}/{y}.
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
# VITE_TILE_URL=
# VITE_TILE_ATTRIBUTION=
# Firebase web (opcional). El build de producción ya lee frontend/.env.production.
# Solo hace falta definirlas aquí para sustituir esa config en la imagen Docker.
# Un valor vacío no se inyecta y no borra el archivo de producción.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Vite en el anfitrión: frontend/.env.local (ver frontend/.env.example)