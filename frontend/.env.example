# Desarrollo Vite en la computadora anfitriona (solo localhost):
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Desarrollo Vite accesible en LAN (sustituye HOST_LAN por tu IPv4, sin hardcodear en el repo):
# VITE_API_BASE_URL=http://HOST_LAN:8000/api/v1

# Build Docker / nginx (mismo origen; no uses localhost aquí):
# En el .env de la raíz del proyecto usa DOCKER_WEB_API_BASE_URL=/api/v1

# Tiles (dev de Vite). Si se omiten, el mapa usa Esri World Light Gray.
# VITE_MAP_TILE_URL tiene prioridad sobre VITE_TILE_URL.
# VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_TILE_ATTRIBUTION=Mapa base © Esri

# Firebase en dev. Si se omiten, el login usa la API local.
# El build de producción lee frontend/.env.production.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=